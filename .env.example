# App
APP_ENV=development
APP_URL=http://localhost/task_management

# Database (choose DATABASE_URL or PG* vars)
# DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=your_db_name
# PGUSER=your_db_user
# PGPASSWORD=your_db_password
# PGSSLMODE=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_mail_app_password
MAIL_FROM_ADDRESS=your_email@example.com
MAIL_FROM_NAME=Task Management System
DISABLE_LOGIN_VERIFICATION_ON_RAILWAY=0

# Google Sign-In
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_web_client_secret
ALLOW_MAINTENANCE_SCRIPTS=0
ALLOW_GLOBAL_MAINTENANCE=1
