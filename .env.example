# App
# Set this to the exact base URL for the current environment.
# Local example:   APP_URL=http://localhost/task_management_v2
# Railway example: APP_URL=https://your-app.up.railway.app
APP_ENV=development
APP_URL=http://localhost/task_management

# PayMongo (test mode)
# Use your test secret key while building:
# PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Database (MySQL / Hostinger)
# For Hostinger shared hosting, DB_HOST is usually localhost.
# If hPanel gives you a different MySQL Host or username, use that instead.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_your_db
DB_USER=u123456789_your_db
DB_PASS=your_db_password
DB_TIMEOUT=5

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_mail_app_password
MAIL_FROM_ADDRESS=your_email@example.com
MAIL_FROM_NAME=Task Management System
MAIL_TIMEOUT=10
DISABLE_LOGIN_VERIFICATION=0
DISABLE_LOGIN_VERIFICATION_ON_RAILWAY=0

# Google Sign-In / basic identity client
# Login/signup/invite flows use this client only.
# Allowed scopes: openid, email, profile.
GOOGLE_LOGIN_CLIENT_ID=your_google_login_web_client_id.apps.googleusercontent.com
GOOGLE_LOGIN_CLIENT_SECRET=your_google_login_web_client_secret

# Google Workspace API client
# Drive/Calendar/Gmail integrations use this client only.
# Allowed scopes: openid, email, profile, drive.file, calendar.events.owned, gmail.send.
GOOGLE_WORKSPACE_CLIENT_ID=your_google_workspace_web_client_id.apps.googleusercontent.com
GOOGLE_WORKSPACE_CLIENT_SECRET=your_google_workspace_web_client_secret
ALLOW_MAINTENANCE_SCRIPTS=0
ALLOW_GLOBAL_MAINTENANCE=1
